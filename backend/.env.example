PORT=5000

# Chọn MySQL khi dùng database server bên ngoài
DB_DIALECT=mysql
DB_NAME=BTL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=2101
# Aiven MySQL thường require SSL
# Render: set DB_SSL=true
# Nếu provider yêu cầu CA certificate: copy nội dung CA cert (PEM) vào DB_CA_CERT
DB_SSL=false
DB_CA_CERT=
DB_SSL_REJECT_UNAUTHORIZED=false

JWT_SECRET=your_secret_key

# CORS origins cho môi trường deploy (Netlify domain, ...)
# Ví dụ:
# CORS_ORIGINS=https://your-site.netlify.app,https://main--your-site.netlify.app
CORS_ORIGINS=